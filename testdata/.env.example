# Baseline Environment Specification for SMK Telkom Application
# Standard template used for CI/CD drift verification

APP_NAME=telkom-portal
APP_ENV=production
PORT=8080
DEBUG=false

# Database Configuration
DATABASE_URL=postgres://app_user:db_password@postgres.internal:5432/telkom_prod?sslmode=require
DATABASE_POOL_SIZE=25
DATABASE_TIMEOUT=10s

# Authentication & Security
JWT_SECRET=super-secret-production-signing-key-high-entropy-67890
SESSION_EXPIRY=24h
ADMIN_EMAIL=security@smktelkom-mks.sch.id
OAUTH_CLIENT_ID=00000000-1111-2222-3333-444444444444

# External Services
PAYMENT_GATEWAY_URL=https://api.payment.provider.com/v2
METRICS_PORT=9090
ALLOWED_ORIGINS={"domains":["https://smktelkom-mks.sch.id","https://portal.smktelkom-mks.sch.id"]}
