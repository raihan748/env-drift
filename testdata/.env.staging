# Staging Environment Configuration
APP_NAME=telkom-portal-staging
APP_ENV=staging
PORT=8080
DEBUG=true

# Database Configuration
DATABASE_URL=postgres://app_user:staging_pass@postgres-stage.internal:5432/telkom_stage
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=15s

# Authentication & Security
JWT_SECRET=staging-signing-token-xyz-1234567890
SESSION_EXPIRY=12h
ADMIN_EMAIL=qa-team@smktelkom-mks.sch.id
OAUTH_CLIENT_ID=00000000-1111-2222-3333-444444444444

# External Services
PAYMENT_GATEWAY_URL=https://sandbox.payment.provider.com/v2
METRICS_PORT=9090
ALLOWED_ORIGINS={"domains":["https://stage.smktelkom-mks.sch.id"]}
STAGING_DEBUG_BANNER=true
